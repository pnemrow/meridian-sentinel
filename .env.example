# Meridian Sentinel — environment template
#
# Copy this to .env (gitignored) and populate. Loaded by docker-compose and uvicorn.

SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# Optional (defaults shown):
# OUTPUT_DIR=./output
# OFAC_CACHE_DIR=./services/api/data
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
