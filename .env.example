# Meridian Sentinel — environment template
#
# Copy this file to .env (which is gitignored) and populate as needed.
# Loaded by docker-compose and by uvicorn through python-dotenv.
#
# Quick rules:
#   - CACHED mode requires NO credentials. The entire deliverable
#     (compare reconciliation, entity briefings, 4 golden copilot runs,
#     49 cached entity profiles, ownership graphs for every list_1
#     entity) works without anything in this file.
#   - LIVE mode requires Sayari credentials. Used when you want to upload
#     a new vendor list and exercise the engine against the real API.
#   - ANTHROPIC_API_KEY is only required for freeform LIVE copilot
#     questions. The 4 cached golden runs work without it.

# -----------------------------------------------------------------------------
# Sayari API (required for LIVE uploads and live ownership traversals)
# -----------------------------------------------------------------------------
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Anthropic API (required only for LIVE freeform copilot questions)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional overrides. Defaults work for both Docker and native runs.
# -----------------------------------------------------------------------------

# Where the cached entity profiles and run artifacts live.
# OUTPUT_DIR=./output

# Where the cached OFAC SDN.xml is read from.
# OFAC_CACHE_DIR=./services/api/data

# Postgres connection (only used when running with `docker compose --profile db up`).
# When empty, the app uses file based persistence (the demo path).
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
