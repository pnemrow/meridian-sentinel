node_modules/
.venv/
__pycache__/
*.pyc
.env
.DS_Store
replit_reference/

# Smoke test and dev artifacts that should not ship.
output/dispositions.json
output/runs/*/dispositions.json
output/smoke_test_report.csv

# The OFAC SDN feed at services/api/data/sdn.xml (28MB) is intentionally
# committed so CACHED mode does the full OFAC reconciliation on a fresh
# clone without any download step or credentials.

# Local backups taken before re captures, not source of truth.
output/agent_runs.bak-*/

# Per upload runs are ~50MB each (50 raw Sayari responses), regenerated on demand.
# Whitelist the pinned demo list_3 run so the reviewer can drive CACHED mode
# (entity detail + ownership graph) end to end without re running an upload.
# NB: must ignore the *contents* (output/runs/*), not the directory itself,
# so git can recurse into the whitelisted run.
output/runs/*
!output/runs/run_20260528_040151_71d93a/

# Walkthrough deliverables (deck + leave-behind) are presentation artifacts
# delivered by email, not committed to the product repo. The ADRs live in
# docs/adr/ instead. These binaries are generated locally for emailing.
docs/walkthrough/*.pptx
docs/walkthrough/*.pdf
